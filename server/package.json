{
  "name": "randomchat-server",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Realtime server for ChatSpark: text chat matching and Underground FM rooms",
  "scripts": {
    "dev": "node --env-file-if-exists=.env --watch src/index.js",
    "start": "node --env-file-if-exists=.env src/index.js",
    "test": "node --test --test-timeout=90000"
  },
  "engines": {
    "node": ">=22.9"
  },
  "dependencies": {
    "socket.io": "^4.8.1"
  },
  "devDependencies": {
    "socket.io-client": "^4.8.1"
  }
}
