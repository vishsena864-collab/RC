# Copy to .env and load it however you start the server (Railway: set these as service variables).

PORT=4000

# Your website origin(s), comma separated. Must match exactly (scheme + host, no trailing slash).
CORS_ORIGINS=http://localhost:3000
# Railway production example (existing domains retained during migration):
# CORS_ORIGINS=https://chatsparkrc.com,https://www.chatsparkrc.com,https://chatspark-rc.vercel.app,https://randomchat-indol.vercel.app

# Only true behind a restricted TRUSTED proxy / Cloudflare ingress. Never expose the origin publicly
# while honoring forwarded IP headers. Raw IPs are immediately converted to keyed fingerprints.
TRUST_PROXY=false

# MANDATORY for production: random secret of at least 32 bytes, not committed to Git.
# Generate: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
# If unset, a new secret is created each restart and existing bans will stop matching.
PRIVACY_HMAC_SECRET=

# Reports with up to 12 recent messages: automatically deleted after 1-30 days (default 7).
REPORT_RETENTION_DAYS=7

# Text-only by design. VIDEO_ENABLED is intentionally ignored to prevent peer IP leaks.
VIDEO_ENABLED=false

# Keep false until real age verification is wired into src/verification.js.
ADULT_ENABLED=false

# Matching: how long people with interests wait for a shared-interest match before matching with anyone.
MATCH_RELAX_MS=8000

# Moderation: this many different reporters in 24h blocks an IP for BAN_MS milliseconds (default 1 hour).
REPORTS_TO_BAN=3
BAN_MS=3600000

# Rate limit: join/skip attempts per minute per connection.
JOINS_PER_WINDOW=30

# Only needed when video is switched on.
# STUN_URLS=stun:stun.l.google.com:19302
# TURN_URLS=turn:turn.example.com:3478,turns:turn.example.com:443?transport=tcp
# TURN_SECRET=shared-secret-from-coturn-static-auth-secret
